<!DOCTYPE html>
<html lang="uz">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BIO DUNYO | Tabiatni asraylik</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');

:root {
    --green: #16834b;
    --dark-green: #075c35;
    --light-green: #e9f7ed;
    --text: #183b2b;
    --background: #f8fcf8;
    --card: #ffffff;
    --shadow: 0 8px 25px rgba(0,0,0,.08);
}

body.dark {
    --text: #e7f5eb;
    --background: #10251b;
    --card: #193527;
    --light-green: #244b35;
    --shadow: 0 8px 25px rgba(0,0,0,.25);
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    font-family: 'Poppins', sans-serif;
    background: var(--background);
    color: var(--text);
    transition: .3s;
}

a {
    text-decoration: none;
    color: inherit;
}

button {
    font-family: inherit;
    cursor: pointer;
    border: none;
}

header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: var(--card);
    box-shadow: var(--shadow);
}

.navbar {
    max-width: 1200px;
    margin: auto;
    padding: 17px 5%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
}

.logo {
    font-size: 25px;
    font-weight: 800;
    color: var(--green);
}

.logo span {
    color: var(--text);
}

.nav-links {
    display: flex;
    align-items: center;
    gap: 20px;
}

.nav-links a {
    font-size: 13px;
    font-weight: 600;
    transition: .3s;
}

.nav-links a:hover {
    color: var(--green);
}

.nav-actions {
    display: flex;
    gap: 8px;
    align-items: center;
}

.nav-actions button,
.nav-actions select {
    padding: 9px 11px;
    border-radius: 9px;
    background: var(--light-green);
    color: var(--text);
    font-size: 13px;
}

.menu-btn {
    display: none;
    font-size: 23px;
    background: none;
    color: var(--text);
}

.hero {
    min-height: 590px;
    padding: 100px 8%;
    display: flex;
    align-items: center;
    color: white;
    background:
    linear-gradient(90deg, rgba(0,45,25,.88), rgba(0,45,25,.25)),
    url('https://images.unsplash.com/photo-1448375240586-882707db888b?w=1800')
    center/cover;
}

.hero-content {
    max-width: 700px;
    animation: appear 1s ease;
}

.hero h1 {
    font-size: clamp(38px, 6vw, 68px);
    line-height: 1.15;
    margin-bottom: 20px;
}

.hero p {
    font-size: 17px;
    line-height: 1.8;
    margin-bottom: 30px;
}

.btn {
    display: inline-block;
    padding: 13px 25px;
    border-radius: 30px;
    background: #42bd75;
    color: white;
    font-weight: 600;
    transition: .3s;
}

.btn:hover {
    background: #16834b;
    transform: translateY(-3px);
}

section {
    padding: 80px 7%;
    scroll-margin-top: 75px;
}

.section-title {
    text-align: center;
    margin-bottom: 45px;
}

.section-title h2 {
    font-size: clamp(27px, 4vw, 38px);
    color: var(--green);
    margin-bottom: 10px;
}

.section-title p {
    color: var(--text);
    opacity: .75;
}

.about-content {
    max-width: 1100px;
    margin: auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
}

.about-content img {
    width: 100%;
    height: 350px;
    object-fit: cover;
    border-radius: 20px;
    box-shadow: var(--shadow);
}

.about-text h3 {
    font-size: 26px;
    margin-bottom: 15px;
}

.about-text p {
    line-height: 1.9;
    margin-bottom: 15px;
    opacity: .85;
}

.cards {
    max-width: 1200px;
    margin: auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 25px;
}

.card {
    background: var(--card);
    border-radius: 17px;
    overflow: hidden;
    box-shadow: var(--shadow);
    transition: .35s;
}

.card:hover {
    transform: translateY(-8px);
}

.card img {
    width: 100%;
    height: 190px;
    object-fit: cover;
}

.card-content {
    padding: 22px;
}

.card-content h3 {
    color: var(--green);
    margin-bottom: 10px;
}

.card-content p {
    font-size: 14px;
    line-height: 1.8;
    opacity: .8;
}

.tips-search {
    max-width: 500px;
    display: block;
    margin: 0 auto 35px;
    width: 100%;
    padding: 14px 18px;
    border: 1px solid #b5d9c0;
    border-radius: 30px;
    outline: none;
    background: var(--card);
    color: var(--text);
    font-size: 15px;
}

.tips-search:focus {
    border-color: var(--green);
}

.stats {
    background: linear-gradient(120deg, #075c35, #16834b);
    color: white;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 25px;
    text-align: center;
}

.stat h3 {
    font-size: 38px;
    margin-bottom: 5px;
}

.stat p {
    opacity: .85;
}

.gallery {
    max-width: 1200px;
    margin: auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 15px;
}

.gallery img {
    width: 100%;
    height: 230px;
    object-fit: cover;
    border-radius: 15px;
    transition: .3s;
}

.gallery img:hover {
    transform: scale(1.035);
}

.quiz-box {
    max-width: 700px;
    margin: auto;
    padding: 30px;
    background: var(--card);
    box-shadow: var(--shadow);
    border-radius: 20px;
}

.quiz-box h3 {
    color: var(--green);
    margin-bottom: 20px;
}

.quiz-option {
    display: block;
    width: 100%;
    padding: 14px;
    margin: 10px 0;
    text-align: left;
    border-radius: 10px;
    background: var(--light-green);
    color: var(--text);
    transition: .2s;
}

.quiz-option:hover {
    background: #bde8ca;
    color: #075c35;
}

.quiz-option:disabled {
    cursor: default;
    opacity: .85;
}

#quiz-result {
    margin-top: 20px;
    font-weight: 600;
}

footer {
    background: #073c27;
    color: white;
    text-align: center;
    padding: 35px 15px;
}

footer p {
    margin: 8px 0;
    opacity: .8;
}

.socials {
    margin: 15px 0;
}

.socials a {
    margin: 0 10px;
    color: #a8edbd;
}

.reveal {
    opacity: 0;
    transform: translateY(30px);
    transition: .7s;
}

.reveal.show {
    opacity: 1;
    transform: translateY(0);
}

@keyframes appear {
    from { opacity: 0; transform: translateY(25px); }
    to { opacity: 1; transform: translateY(0); }
}

@media(max-width: 950px) {
    .nav-links {
        display: none;
        position: absolute;
        top: 72px;
        left: 0;
        width: 100%;
        padding: 20px;
        background: var(--card);
        flex-direction: column;
        align-items: flex-start;
        box-shadow: var(--shadow);
    }

    .nav-links.active {
        display: flex;
    }

    .menu-btn {
        display: block;
    }

    .about-content {
        grid-template-columns: 1fr;
    }
}

@media(max-width: 500px) {
    .navbar {
        padding: 15px 4%;
    }

    .logo {
        font-size: 20px;
    }

    .nav-actions {
        gap: 5px;
    }

    .nav-actions button,
    .nav-actions select {
        padding: 8px;
        font-size: 11px;
    }

    .hero {
        min-height: 500px;
        padding: 70px 7%;
    }

    section {
        padding: 60px 6%;
    }

    .quiz-box {
        padding: 20px;
    }
}
</style>
</head>

