let questionIndex = 0;
let score = 0;
let answered = false;

function showQuestion() {
    const list = questions[currentLanguage];
    const question = list[questionIndex];

    document.getElementById("question").textContent = question.q;
    document.getElementById("quiz-result").textContent = "";
    document.getElementById("nextBtn").style.display = "none";

    const options = document.getElementById("options");
    options.innerHTML = "";
    answered = false;

    question.a.forEach((answer, index) => {
        const button = document.createElement("button");
        button.className = "quiz-option";
        button.textContent = answer;

        button.onclick = () => checkAnswer(index, button);
        options.appendChild(button);
    });
}

function checkAnswer(index, button) {
    if (answered) return;

    answered = true;

    const question = questions[currentLanguage][questionIndex];
    const buttons = document.querySelectorAll(".quiz-option");

    buttons.forEach((b, i) => {
        b.disabled = true;

        if (i === question.c) {
            b.style.background = "#a7e8b7";
        }
    });

    if (index === question.c) {
        score++;
        document.getElementById("quiz-result").textContent =
            currentLanguage === "uz" ? "✅ To‘g‘ri javob!" :
            currentLanguage === "ru" ? "✅ Правильный ответ!" :
            "✅ Correct answer!";
    } else {
        document.getElementById("quiz-result").textContent =
            currentLanguage === "uz" ? "❌ Noto‘g‘ri javob!" :
            currentLanguage === "ru" ? "❌ Неправильный ответ!" :
            "❌ Incorrect answer!";
    }

    document.getElementById("nextBtn").style.display = "inline-block";
}

function nextQuestion() {
    questionIndex++;

    if (questionIndex < questions[currentLanguage].length) {
        showQuestion();
    } else {
        const result = document.getElementById("question");

        result.textContent =
            currentLanguage === "uz" ? "Test yakunlandi! 🎉" :
            currentLanguage === "ru" ? "Тест завершён! 🎉" :
            "Quiz completed! 🎉";

        document.getElementById("options").innerHTML = "";

        document.getElementById("quiz-result").textContent =
            currentLanguage === "uz"
            ? `Siz ${5} ta savoldan ${score} tasiga to‘g‘ri javob berdingiz!`
            : currentLanguage === "ru"
            ? `Вы правильно ответили на ${score} из 5 вопросов!`
            : `You answered ${score} out of 5 questions correctly!`;

        const next = document.getElementById("nextBtn");
        next.textContent =
            currentLanguage === "uz" ? "Qayta boshlash ↻" :
            currentLanguage === "ru" ? "Начать заново ↻" :
            "Restart ↻";

        next.style.display = "inline-block";
        next.onclick = restartQuiz;
    }
}

function restartQuiz() {
    questionIndex = 0;
    score = 0;

    const next = document.getElementById("nextBtn");
    next.onclick = nextQuestion;
    next.textContent = "Keyingi savol →";

    showQuestion();
}

showQuestion();

/* Animatsiyalar */

const observer = new IntersectionObserver(entries => {
    entries.forEach(entry => {
        if (entry.isIntersecting) {
            entry.target.classList.add("show");
        }
    });
}, { threshold: 0.12 });

document.querySelectorAll(".reveal").forEach(el => {
    observer.observe(el);
});
